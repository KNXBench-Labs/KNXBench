# Both spellings on purpose: the trailing slash matches only a real
# directory, so a *symlink* named OriginalData — which is how a worktree
# borrows the corpus — sails straight past it and into `git add -A`.
OriginalData/
OriginalData
node_modules/
AGENTS.md.bak.*
.claude/.headroom_wrap_settings.lock
.serena/project.yml
.ai/
DREAMS.md
SOUL.md
USER.md
IDENTITY.md
MEMORY.md
MEMORY.md.bak.*
# Local Claude Code state stays private; only the shared project settings
# (attribution off) are versioned. `.claude/*` rather
# than `.claude/` because git cannot re-include a file below an ignored
# directory.
.claude/*
!.claude/settings.json
memory/
.agent-memory/

# Lokale Projekt-Exporte (Privatinstallation, nichts fuer die Nachwelt)
devices.md
devices.json
group_addresses.json
project_dump.json
*_project_dump.json
monitor_bus.py

# Server-Laufzeitverzeichnis: Uploads, erzeugte Reports, lokale DB.
# Enthaelt echte Projektdateien. Nichts davon gehoert ins Repo.
data/

# Statusarchive: Momentaufnahmen, kein Quellcode
Backup/

# TypeScript incremental build state (tsc -b), never source
*.tsbuildinfo

# Private personal data (e.g. claude.ai account exports). Never versioned.
/.private/

# ProjectStats private local state
/.projectstats.json
/.projectstats/

# Agent internals: handover logs, goal ledgers, the shared memory tooling and
# the retired cloud-session kit. They live on in the maintainer's checkout
# (and in history), not in the public tree.
/alpha-release-goal.md
/goal-ui.md
/goal-commission.md
/IDEA.md
/compare.md
/stats.md
