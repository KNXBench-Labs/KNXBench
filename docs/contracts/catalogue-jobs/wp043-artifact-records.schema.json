  "$defs": {
    "U64": {
      "type": "string",
      "maxLength": 20,
      "x-maxUtf8Bytes": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "x-maximumDecimal": "18446744073709551615"
    },
    "Id": {
      "type": "string",
      "maxLength": 32,
      "x-maxUtf8Bytes": 32,
      "pattern": "^[0-9a-f]{32}$"
    },
    "Digest": {
      "type": "string",
      "maxLength": 64,
      "x-maxUtf8Bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "Withheld": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "name",
            "sample",
            "detail",
            "alias",
            "declarationId",
            "targetPath",
            "installOnImport",
            "timeInfo",
            "fileVersion"
          ]
        },
        "reason": {
          "const": "untrustedFreeText"
        },
        "rawUtf8Bytes": {
          "$ref": "#/$defs/U64"
        }
      },
      "required": [
        "field",
        "reason",
        "rawUtf8Bytes"
      ],
      "additionalProperties": false
    },
